
RESEND_API_KEY=
CONTACT_TO_EMAIL=

# Optional. Sender address. Defaults to "Portfolio <onboarding@resend.dev>", which only
# delivers to your own Resend account email. Use an address on a domain verified in Resend
# (e.g. "Portfolio <hello@yourdomain.com>") to send without that limit.
CONTACT_FROM_EMAIL=

# Your live site address, with no trailing slash (e.g. https://yourname.com). Used for canonical
# URLs, the sitemap, social preview images and structured data. On Vercel it defaults to the
# production domain, but set it explicitly once you have a custom domain.
NEXT_PUBLIC_SITE_URL=

# Optional. Google Search Console "HTML tag" verification code (just the content="..." value).
GOOGLE_SITE_VERIFICATION=
